{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-outfitter.com/schemas/output-type.git-branch.schema.json",
  "$comment": "Forge-neutral subset of GitHub and Forgejo GET /repos/{owner}/{repo}/branches/{branch} responses.",
  "title": "Git branch workflow output value",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "commit", "repository"],
  "properties": {
    "name": { "type": "string" },
    "commit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sha"],
      "properties": { "sha": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" } }
    },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" }
  }
}
